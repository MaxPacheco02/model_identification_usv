<?xml version="1.0" ?>
<!-- Identification world: the asv_nav USV (model://usv) on the gz-waves wave field, wind speed
     @WIND@ m/s for the fft spectrum (0 = flat water). Generated by CMake from id_world.sdf.in. -->
<sdf version="1.6">
  <world name="id">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- body-fixed external wrench on the hull (sway tests, the simulated rotated thruster) -->
    <plugin filename="model_identification_usv_body_wrench" name="model_identification_usv::BodyWrench">
      <link_name>usv::base_link</link_name>
      <topic>/id/body_wrench</topic>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <grid>false</grid>
      <background>0.8 0.8 0.8</background>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- wave field only (no visual): the Hydrodynamics system of the USV looks it up by the
         entity name "wavefield" that this plugin creates -->
    <model name="waves">
      <static>true</static>
      <plugin filename="gz-waves1-waves-model-system" name="gz::sim::systems::WavesModel">
        <static>0</static>
        <update_rate>30</update_rate>
        <wave>
          <algorithm>fft</algorithm>
          <tile_size>64</tile_size>
          <cell_count>64</cell_count>
          <wind_speed>@WIND@</wind_speed>
          <wind_angle_deg>135</wind_angle_deg>
          <steepness>2</steepness>
        </wave>
      </plugin>
    </model>

    <include>
      <name>usv</name>
      <pose>0 0 0.1 0 0 0</pose>
      <uri>model://usv</uri>
    </include>
  </world>
</sdf>
